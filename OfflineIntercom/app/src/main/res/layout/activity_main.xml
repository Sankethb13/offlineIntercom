<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101418"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Works offline · local Wi-Fi or Bluetooth"
        android:textColor="#8A97A6"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Your name"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="24"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#66717D" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Channel"
            android:textColor="#8A97A6"
            android:layout_marginStart="12dp" />

        <Spinner
            android:id="@+id/channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFFFFF" />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/modeWifi"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Wi-Fi (group)"
            android:textColor="#FFFFFF"
            android:buttonTint="#3DDC84" />

        <RadioButton
            android:id="@+id/modeBt"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Bluetooth (1-to-1)"
            android:textColor="#FFFFFF"
            android:buttonTint="#3DDC84" />
    </RadioGroup>

    <!-- Wi-Fi panel -->
    <LinearLayout
        android:id="@+id/wifiPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/wifiToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Wi-Fi intercom" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="People on this channel"
            android:textColor="#8A97A6"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/peers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:text="—" />
    </LinearLayout>

    <!-- Bluetooth panel -->
    <LinearLayout
        android:id="@+id/btPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btHost"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Host" />

            <Button
                android:id="@+id/btDisconnect"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Disconnect" />

            <Button
                android:id="@+id/btSettings"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Pair…" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap a paired phone to connect to it"
            android:textColor="#8A97A6"
            android:layout_marginTop="8dp" />

        <ListView
            android:id="@+id/btDevices"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#3DDC84"
        android:textSize="14sp"
        android:minLines="2"
        android:text="Not connected" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/handsFree"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Hands-free"
            android:textColor="#FFFFFF" />

        <Switch
            android:id="@+id/speaker"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Loudspeaker"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <Button
        android:id="@+id/ptt"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/ptt_bg"
        android:text="HOLD TO TALK"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>
